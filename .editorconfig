root = true

[*]
indent_style = space
indent_size = 2
end_of_line = crlf
insert_final_newline = true
trim_trailing_whitespace = false

# Preserve legacy source encodings; only these known formats default to UTF-8.
[*.{md,ps1,sh,yml,yaml}]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[*.ps1]
indent_size = 4

[tests/**]
charset = utf-8
indent_style = space
indent_size = 4
end_of_line = lf
trim_trailing_whitespace = true

[*.{vcxproj,filters,props}]
charset = utf-8

[{.editorconfig,.gitattributes,.gitignore}]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[.githooks/*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

[{src/Notepad2.rc,Notepad2.ini,distrib/Notepad2.ini}]
charset = utf-16le

# Do not rewrite vendor formatting, encodings or line endings.
[scintilla/**]
charset = unset
indent_style = tab
indent_size = tab
tab_width = 4
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset

[scintilla/*.{vcxproj,filters}]
indent_style = space
indent_size = 2
end_of_line = crlf

[scintilla/README.notepad2-mod.txt]
charset = utf-8
indent_style = space
indent_size = 2
