#!/bin/sh
if command -v pwsh >/dev/null 2>&1; then
    exec pwsh -NoProfile -File build/check-staged.ps1
elif command -v powershell.exe >/dev/null 2>&1; then
    exec powershell.exe -NoProfile -ExecutionPolicy Bypass -File build/check-staged.ps1
else
    echo "PowerShell is required to run build/check-staged.ps1." >&2
    exit 1
fi
